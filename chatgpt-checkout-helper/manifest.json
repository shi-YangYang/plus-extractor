{
  "manifest_version": 3,
  "name": "[Deprecated] Plus Extractor - Two-stage Proxy Flow",
  "version": "0.2.4",
  "description": "Deprecated reference implementation. New development has moved to the local Web UI and Local API.",
  "minimum_chrome_version": "102",
  "permissions": [
    "proxy",
    "storage",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "stripe_init_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
