{
  "manifest_version": 3,
  "name": "Plus Extractor - Two-stage Proxy Flow",
  "version": "0.2.2",
  "description": "Verified US-to-TR PH_SHORT flow with hard CONNECT tunnel reset before applying the 100% Plus campaign.",
  "minimum_chrome_version": "102",
  "permissions": [
    "proxy",
    "storage",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "stripe_init_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
